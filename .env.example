# PostgreSQL 17 (btree_gist extension required)
DATABASE_URL=postgres://swisschalets:CHANGE_ME@127.0.0.1:5432/swisschalets
# Root folder for media, proofs, keys, backups, logs (outside the web root)
DATA_DIR=/var/swisschalets
# Public base URL (used in Telegram links and sitemap)
APP_URL=https://example.com
# Telegram bot (optional until deployment)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# First super admin (used by `npm run db:seed` only)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
